{#- A project, with a link to its website. -#}
{% extends 'page.html.twig' %}

{%- block after_content ~%}
{{- parent() -}}
{%- if page.url is defined ~%}
                    <div class="content mt-8">
                      <p><a href="{{ url(page.url) }}" title="Site web du projet">{{ url(page.url) }}</a></p>
                    </div>
{%- endif ~%}
{%- endblock after_content ~%}