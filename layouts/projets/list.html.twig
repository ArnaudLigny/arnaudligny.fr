{#- The list of the projects, displayed as cards. -#}
{% extends 'list.html.twig' %}

{%- block main ~%}
                  <section>
                    <h1 class="h1 font-aspekta mb-5">{{ page.title }}</h1>
                    {%- if page.content ~%}
                    <div class="content mb-8">
                      {{- page.content ~}}
                    </div>
                    {%- endif ~%}
                    {%- set cards = [] -%}
                    {%- for p in page.pages|sort_by_weight -%}
                      {%- set cards = cards|merge([{title: p.title, text: p.description|default(''), url: p}]) -%}
                    {%- endfor ~%}
                    {{- include('partials/cards.html.twig', {section: {cards: cards}}) ~}}
                  </section>
{%- endblock main ~%}