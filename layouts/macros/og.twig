{#- Builds the URL of the social card generated by Cloudinary for a given title. -#}
{%- macro card(title, account, asset) -%}
{%- set text = title|trim('.')|url_encode|replace({'%2C': '%252C'}) -%}
{%- set y = text|length > 60 ? 120 : 200 -%}
{{- 'https://res.cloudinary.com/%s/image/upload/f_auto,q_auto/w_1000,c_fit,co_black,g_north_west,x_80,y_%s,l_text:neuton_100_ultrabold_line_spacing_-10:%s/%s'|format(account, y, text, asset) -}}
{%- endmacro -%}