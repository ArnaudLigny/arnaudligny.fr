{#- Builds the URL of the social card generated by Cloudinary for a given title. -#}
{%- macro card(title, account, asset) -%}
{#- Cloudinary generation options -#}
{%- set delivery = 'f_auto,q_auto' -%}
{#- set font = 'neuton_100_ultrabold_line_spacing_-10' -#}
{%- set font = 'Inter@google_90_600_line_spacing_-10' -%}
{%- set width = 1000 -%}
{%- set color = 'black' -%}
{%- set gravity = 'north_west' -%}
{%- set x = 80 -%}
{%- set y_long = 120 -%}  {#- vertical offset for long titles -#}
{%- set y_short = 200 -%} {#- vertical offset for short titles -#}
{%- set long_title_length = 60 -%}
{#- URL building -#}
{%- set text = title|trim('.')|url_encode|replace({'%2C': '%252C'}) -%}
{%- set y = text|length > long_title_length ? y_long : y_short -%}
{{- 'https://res.cloudinary.com/%s/image/upload/%s/w_%s,c_fit,co_%s,g_%s,x_%s,y_%s,l_text:%s:%s/%s'|format(account, delivery, width, color, gravity, x, y, font, text, asset) -}}
{%- endmacro ~%}