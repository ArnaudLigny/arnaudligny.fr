{#- A blog post, with comments. -#}
{% extends 'base-post.html.twig' %}

{%- block main ~%}
{{- parent() -}}
{%- if page.comments|default(false) and site.comments|default(false) != false ~%}
                  <aside id="comments" class="mt-10">
                    <script src="https://giscus.app/client.js"
                      data-repo="ArnaudLigny/arnaudligny.fr"
                      data-repo-id="MDEwOlJlcG9zaXRvcnkxNjQ5NTcxOA=="
                      data-category="Announcements"
                      data-category-id="DIC_kwDOAPu0Zs4Cb8aF"
                      data-mapping="pathname"
                      data-strict="0"
                      data-reactions-enabled="1"
                      data-emit-metadata="0"
                      data-input-position="bottom"
                      data-theme="preferred_color_scheme"
                      data-lang="fr"
                      data-loading="lazy"
                      crossorigin="anonymous"
                      async>
                    </script>
                  </aside>
{%- endif ~%}
{%- endblock main ~%}