{#- Base layout of a dated page (a blog post, a talk): the DevSpace post layout, plus the additions of the site. -#}
{#- Open Graph image generated by the ogimage theme, if the page has no image -#}
{%- set image = og_image(page) -%}
{% extends 'post.html.twig' %}

{%- block head -%}{{ parent() }}{% include 'partials/site-head.html.twig' %}{%- endblock head -%}
{%- block footer -%}{{ parent() }}{% include 'partials/site-print-footer.html.twig' %}{%- endblock footer -%}
{%- block js -%}{{ parent() }}{% include 'partials/site-scripts.html.twig' %}{%- endblock js -%}