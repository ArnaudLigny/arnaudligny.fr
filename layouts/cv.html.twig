{#- The resume page (`layout: cv`): the profile picture, the intro, the content of the homepage and the timeline of the `sections`. -#}
{% extends 'page.html.twig' %}

{%- block head -%}
{{- parent() -}}
<meta property="profile:first_name" content="{{ site.profile.firstname }}">
<meta property="profile:last_name" content="{{ site.profile.lastname }}">
<meta property="profile:username" content="{{ site.profile.username }}">
<style>{% apply minify_css ~%}
  @media print {
    /* break page before the experience timeline */
    #experience {
      page-break-before: always;
    }
  }
{% endapply %}</style>
{%- endblock head -%}

{%- block title ~%}
                    <div class="flex items-center gap-5 mb-5">
                      {%- if page.image ~%}
                      <img class="rounded-full shrink-0 hidden md:block" src="{{ url(asset(page.image)|resize(224)) }}" width="112" height="112" alt="Photo de profil d’{{ site.profile.firstname ~ ' ' ~ site.profile.lastname }}">
                      {%- endif ~%}
                      <h1 class="h1 font-aspekta">{{ page.title }}</h1>
                    </div>
{%- endblock title ~%}

{%- block image ~%}{% endblock image ~%}

{%- block content ~%}
                    <div class="content">
                      {{- page.intro|markdown_to_html -}}
                      {{- site.page('index').content|markdown_to_html ~}}
                    </div>
{%- endblock content ~%}

{%- block after_content ~%}
{%- if page.sections|default([])|length > 0 ~%}
                    <div class="space-y-12 mt-10">
                      {%- for section in page.sections ~%}
                      {{- include('partials/cv-timeline.html.twig', {section: section}) ~}}
                      {%- endfor ~%}
                    </div>
{%- endif ~%}
{%- endblock after_content ~%}