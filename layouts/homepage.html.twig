{#- The homepage: the DevSpace index layout, with the content styled and the last talks added. -#}
{%- import 'macros/og.twig' as og -%}
{%- if page.image is not defined and site.cloudinary.account|default(false) -%}
  {%- set image = asset(og.card(page.title, site.cloudinary.account, site.cloudinary.asset)|trim ~ '', {filename: 'cards/%s.png'|format(page.title|slugify)}) -%}
{%- endif -%}
{% extends 'index.html.twig' %}

{%- block hero ~%}
            <section>
              <div class="max-w-[700px]">
                <div class="pt-8 pb-10">
                  {%- if site.devspace.avatar|default(false) ~%}
                  <img class="rounded-full mb-5" src="{{ url(asset(site.devspace.avatar)|resize(112)) }}" width="56" height="56" alt="{{ site.title|e }}">
                  {%- endif ~%}
                  <h1 class="h1 font-aspekta mb-5">{{ hero|raw }}</h1>
                  <div class="content text-lg">
                    {{- page.content ~}}
                  </div>
                </div>
              </div>
            </section>
{%- endblock hero ~%}

{%- block main ~%}
{{- parent() -}}
{%- set talks = site.pages.showable|filter(p => p.type == 'page' and p.section == 'talks')|sort_by_date -%}
{%- if talks|length > 0 -%}
{%- set cards = [] -%}
{%- for talk in talks|slice(0, 4) -%}
  {%- set cards = cards|merge([{title: talk.title, url: talk, image: talk.image|default(false)}]) -%}
{%- endfor ~%}
                  <div class="space-y-10 mt-10">
                    {{- include('partials/cards.html.twig', {section: {title: 'Dernières conférences', type: 'video', cards: cards}}) ~}}
                  </div>
{%- endif -%}
{%- endblock main ~%}

{%- block head -%}{{ parent() }}{% include 'partials/site-head.html.twig' %}{%- endblock head -%}
{%- block footer -%}{{ parent() }}{% include 'partials/site-print-footer.html.twig' %}{%- endblock footer -%}
{%- block js -%}{{ parent() }}{% include 'partials/site-scripts.html.twig' %}{%- endblock js -%}
